{
  "info": {
    "name": "Xeno",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9000"
    },
    {
      "key": "tenantId",
      "value": "ten_default"
    },
    {
      "key": "adminApiKey",
      "value": "xenoadmin"
    },
    {
      "key": "username",
      "value": "admin@xeno"
    },
    {
      "key": "password",
      "value": "xeno"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "OpenAPI",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/openapi.json"
      }
    },
    {
      "name": "Tenants",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-tenant-guid",
            "value": "{{tenantId}}"
          }
        ],
        "url": "{{baseUrl}}/v1.0/api/tenants"
      }
    },
    {
      "name": "Clients",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-tenant-guid",
            "value": "{{tenantId}}"
          }
        ],
        "url": "{{baseUrl}}/v1.0/api/clients"
      }
    },
    {
      "name": "Model Runner Endpoints",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-tenant-guid",
            "value": "{{tenantId}}"
          }
        ],
        "url": "{{baseUrl}}/v1.0/api/model-runner-endpoints"
      }
    },
    {
      "name": "OpenAI Models",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-tenant-guid",
            "value": "{{tenantId}}"
          }
        ],
        "url": "{{baseUrl}}/v1/models"
      }
    },
    {
      "name": "Chat Completion",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-tenant-guid",
            "value": "{{tenantId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"model\":\"llama3.2:latest\",\"messages\":[{\"role\":\"user\",\"content\":\"hello\"}]}"
        },
        "url": "{{baseUrl}}/v1/chat/completions"
      }
    },
    {
      "name": "Embeddings",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-tenant-guid",
            "value": "{{tenantId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"model\":\"text-embedding-3-small\",\"input\":\"hello\"}"
        },
        "url": "{{baseUrl}}/v1/embeddings"
      }
    },
    {
      "name": "Request History",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-tenant-guid",
            "value": "{{tenantId}}"
          }
        ],
        "url": "{{baseUrl}}/v1.0/api/request-history"
      }
    },
    {
      "name": "Request History Summary",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-tenant-guid",
            "value": "{{tenantId}}"
          }
        ],
        "url": "{{baseUrl}}/v1.0/api/request-history/summary?bucketMinutes=60"
      }
    },
    {
      "name": "Login for Client Credential",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-tenant-guid",
            "value": "{{tenantId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\",\"tenantId\":\"{{tenantId}}\"}"
        },
        "url": "{{baseUrl}}/v1.0/api/auth/login"
      }
    },
    {
      "name": "Create Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-tenant-guid",
            "value": "{{tenantId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"adminApiKey\":\"{{adminApiKey}}\"}"
        },
        "url": "{{baseUrl}}/v1.0/api/auth/token"
      }
    },
    {
      "name": "Metrics",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/metrics"
      }
    },
    {
      "name": "Settings",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-tenant-guid",
            "value": "{{tenantId}}"
          }
        ],
        "url": "{{baseUrl}}/v1.0/api/settings"
      }
    },
    {
      "name": "Update Settings",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-tenant-guid",
            "value": "{{tenantId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"Rest\":{\"Hostname\":\"0.0.0.0\",\"Port\":9000,\"Ssl\":false,\"RequireAuthentication\":false},\"Cors\":{\"Enabled\":true,\"AllowedOrigins\":[\"http://localhost:9100\"],\"AllowedHeaders\":[\"Authorization\",\"Content-Type\",\"x-token\",\"x-tenant-guid\"],\"AllowedMethods\":[\"GET\",\"POST\",\"PUT\",\"DELETE\",\"OPTIONS\"]},\"WebSocket\":{\"Enabled\":true,\"Path\":\"/ws/v1/clients\",\"HeartbeatIntervalMs\":15000,\"RequestTimeoutMs\":120000},\"Database\":{\"Type\":\"Sqlite\",\"Filename\":\"data/xeno.db\"},\"Logging\":{\"ConsoleLogging\":true,\"FileLogging\":true,\"LogDirectory\":\"logs\",\"LogFilename\":\"xeno.log\"}}"
        },
        "url": "{{baseUrl}}/v1.0/api/settings"
      }
    },
    {
      "name": "Load Model",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-tenant-guid",
            "value": "{{tenantId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"model\":\"llama3.2:latest\"}"
        },
        "url": "{{baseUrl}}/v1.0/api/model-runner-endpoints/load-model"
      }
    },
    {
      "name": "Analytics Overview",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-tenant-guid",
            "value": "{{tenantId}}"
          }
        ],
        "url": "{{baseUrl}}/v1.0/api/analytics/overview"
      }
    },
    {
      "name": "Backup",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-tenant-guid",
            "value": "{{tenantId}}"
          }
        ],
        "url": "{{baseUrl}}/v1.0/api/backup"
      }
    }
  ]
}
