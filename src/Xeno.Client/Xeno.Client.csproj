<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Xeno.Client.Core\Xeno.Client.Core.csproj" />
    <ProjectReference Include="..\Xeno.Tui\Xeno.Tui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Watson" Version="7.3.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>xeno</AssemblyName>
    <PackageId>xeno</PackageId>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>xeno</ToolCommandName>
    <Authors>Joel Christner</Authors>
    <Company>Joel Christner</Company>
    <Product>Xeno</Product>
    <Description>Cross-platform Xeno client tool.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ApplicationIcon>..\..\assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\logo.png" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="..\..\dashboard\dist-local\**\*" LogicalName="local-dashboard/%(RecursiveDir)%(Filename)%(Extension)" Condition="Exists('..\..\dashboard\dist-local')" />
  </ItemGroup>

</Project>
