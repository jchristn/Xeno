<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>xeno-desktop</AssemblyName>
    <RootNamespace>Xeno.Desktop</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <Authors>Joel Christner</Authors>
    <Company>Joel Christner</Company>
    <Product>Xeno</Product>
    <Description>Xeno desktop application: manage this machine's Xeno client, the models it serves, and the models the Xeno network offers it.</Description>
    <ApplicationIcon>..\..\assets\logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <EnableAvaloniaXamlCompilation>false</EnableAvaloniaXamlCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xeno.Client.Core\Xeno.Client.Core.csproj" />
    <ProjectReference Include="..\Xeno.Desktop.Common\Xeno.Desktop.Common.csproj" />
    <!-- Referenced so xeno (the CLI and background worker) and xeno-tray build into the same folder as
         xeno-desktop; the desktop app starts the worker and launches the tray agent and terminal app from there. -->
    <ProjectReference Include="..\Xeno.Client\Xeno.Client.csproj" />
    <ProjectReference Include="..\Xeno.Tray\Xeno.Tray.csproj" />
  </ItemGroup>

</Project>
