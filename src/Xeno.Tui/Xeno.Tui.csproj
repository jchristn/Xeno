<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <Version>0.2.0</Version>
    <Authors>Joel Christner</Authors>
    <Company>Joel Christner</Company>
    <Product>Xeno</Product>
    <Description>Xeno terminal app (xeno tui), built on TUIKit: the same pages, menus, and actions as the desktop app, in a terminal.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Test.Shared" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUIKit" Version="1.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xeno.Client.Core\Xeno.Client.Core.csproj" />
  </ItemGroup>

</Project>
