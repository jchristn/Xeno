<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <Version>0.2.0</Version>
    <Authors>Joel Christner</Authors>
    <Company>Joel Christner</Company>
    <Product>Xeno</Product>
    <Description>Shared Avalonia building blocks for the Xeno desktop app and tray agent: theme, native menus, About window, dialogs, and layout helpers.</Description>
    <EnableAvaloniaXamlCompilation>false</EnableAvaloniaXamlCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xeno.Client.Core\Xeno.Client.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\logo.png" LogicalName="Xeno.Desktop.Common.logo.png" />
    <EmbeddedResource Include="..\..\assets\logo.ico" LogicalName="Xeno.Desktop.Common.logo.ico" />
  </ItemGroup>

</Project>
