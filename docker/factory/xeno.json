{
  "Rest": {
    "Hostname": "0.0.0.0",
    "Port": 9000,
    "Ssl": false,
    "RequireAuthentication": true
  },
  "Cors": {
    "Enabled": true,
    "AllowedOrigins": ["http://localhost:9100", "http://localhost:9200", "https://app.xenocloud.ai"],
    "AllowedHeaders": ["Authorization", "Content-Type", "x-token", "x-tenant-guid", "x-tenant-id", "x-access-key", "x-signature"],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"]
  },
  "WebSocket": {
    "Enabled": true,
    "Path": "/ws/v1/clients",
    "HeartbeatIntervalMs": 15000,
    "RequestTimeoutMs": 120000
  },
  "Database": {
    "Type": "Postgresql",
    "Server": "xeno-postgres",
    "Port": 5432,
    "DatabaseName": "xeno",
    "Username": "xeno",
    "Password": "xeno"
  },
  "Logging": {
    "ConsoleLogging": true,
    "EnableColors": false,
    "MinimumSeverity": 0,
    "FileLogging": true,
    "LogDirectory": "./logs/",
    "LogFilename": "xeno.log",
    "IncludeDateInFilename": true,
    "Servers": []
  },
  "Ledger": {
    "Enabled": true,
    "BaseUrl": "http://netledger-server:8080",
    "ApiKey": "default",
    "SecretKey": "default",
    "DrainIntervalMs": 1000,
    "MaxBatchSize": 100,
    "MaxQueueDepth": 10000,
    "RequestTimeoutMs": 30000,
    "CreateTenantsAutomatically": true,
    "CreateAccountsAutomatically": true,
    "CommitEntriesImmediately": true
  },
  "Auth": {
    "Issuer": "xeno",
    "SigningKey": "development-only-change-me",
    "SessionMinutes": 60,
    "MaxLoginRequestsPerMinute": 20
  },
  "TelemetryCollection": {
    "Enabled": true,
    "CollectionIntervalSeconds": 60,
    "RequestTimeoutMs": 5000,
    "RetentionDays": 30,
    "PruneIntervalMinutes": 60,
    "CollectHostTelemetry": true,
    "CollectProviderTelemetry": true,
    "PersistRawSnapshots": true,
    "MaxRawSnapshotBytes": 262144,
    "MaxSamplesPerClientResponse": 1,
    "MaxProviderMetricRowsPerResponse": 1000,
    "MaxConcurrentClientRequests": 8
  },
  "Email": {
    "Enabled": false,
    "Provider": "Disabled",
    "FromAddress": "noreply@xenocloud.ai",
    "FromName": "Xeno",
    "ReplyToAddress": "support@xenocloud.ai",
    "SupportAddress": "support@xenocloud.ai",
    "ApplicationBaseUrl": "https://app.xenocloud.ai",
    "SubjectPrefix": "",
    "MaxBodyBytes": 262144,
    "Mailgun": {
      "Domain": "",
      "ApiKey": "",
      "Region": "US"
    },
    "File": {
      "Directory": "data/email-outbox"
    },
    "Notifications": {
      "NotifyPlatformAdministratorsOnTenantCreated": true,
      "NotifyPlatformAdministratorsOnUserJoined": true,
      "NotifyTenantAdministratorsOnUserJoined": true,
      "NotifyNewTenantAdministrator": true,
      "NotifyNewTenantMember": false,
      "PlatformAdministratorRecipients": []
    }
  },
  "Routing": {
    "DefaultTimeoutMs": 300000,
    "LoadBalancingMode": "RoundRobin",
    "Adaptive": {
      "SampleCount": 2,
      "CapacityWeight": 45,
      "InFlightWeight": 30,
      "ClientWeight": 15,
      "HeartbeatWeight": 10
    }
  }
}
