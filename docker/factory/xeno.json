{
  "Rest": {
    "Hostname": "0.0.0.0",
    "Port": 9000,
    "Ssl": false,
    "RequireAuthentication": false
  },
  "Cors": {
    "Enabled": true,
    "AllowedOrigins": ["http://localhost:9100"],
    "AllowedHeaders": ["Authorization", "Content-Type", "x-token", "x-tenant-guid", "x-tenant-id", "x-access-key", "x-secret-key", "x-admin-key", "x-signature"],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"]
  },
  "WebSocket": {
    "Enabled": true,
    "Path": "/ws/v1/clients",
    "HeartbeatIntervalMs": 15000,
    "RequestTimeoutMs": 120000
  },
  "Database": {
    "Type": "Sqlite",
    "Filename": "data/xeno.db"
  },
  "Auth": {
    "Issuer": "xeno",
    "SigningKey": "development-only-change-me",
    "AdminApiKey": "xenoadmin",
    "SessionMinutes": 60
  }
}
