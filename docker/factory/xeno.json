{
  "Rest": {
    "Hostname": "0.0.0.0",
    "Port": 9000,
    "Ssl": false,
    "RequireAuthentication": false
  },
  "Cors": {
    "Enabled": true,
    "AllowedOrigins": ["http://localhost:9100"],
    "AllowedHeaders": ["Authorization", "Content-Type", "x-token", "x-tenant-guid", "x-tenant-id", "x-access-key", "x-secret-key", "x-signature"],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"]
  },
  "WebSocket": {
    "Enabled": true,
    "Path": "/ws/v1/clients",
    "HeartbeatIntervalMs": 15000,
    "RequestTimeoutMs": 120000
  },
  "Database": {
    "Type": "Sqlite",
    "Filename": "data/xeno.db"
  },
  "Auth": {
    "Issuer": "xeno",
    "SigningKey": "development-only-change-me",
    "SessionMinutes": 60
  },
  "Routing": {
    "DefaultTimeoutMs": 300000,
    "LoadBalancingMode": "RoundRobin",
    "Adaptive": {
      "SampleCount": 2,
      "CapacityWeight": 45,
      "InFlightWeight": 30,
      "ClientWeight": 15,
      "HeartbeatWeight": 10
    }
  }
}
